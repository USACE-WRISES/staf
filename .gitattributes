* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.mp4 binary
*.gz binary
# Preserve the frozen candidate bytes, including the recorded CRLF line endings.
apps/easi/data/reference-curves.json -text whitespace=cr-at-eol
apps/easi/data/screening-methods.json -text whitespace=cr-at-eol
apps/stream-curves/streamcurves/_vendor/easi/data/reference-curves.json -text whitespace=cr-at-eol
apps/stream-curves/streamcurves/_vendor/easi/data/screening-methods.json -text whitespace=cr-at-eol
# The NRSA archive manifest records this report's bytes as they were written (CRLF),
# and every multi-cycle build digests that manifest, so the bytes stay as recorded.
apps/stream-curves/data/nrsa/verification_report.md -text
# The same for sources.lock.json and station_screen.meta.json: the archive manifest
# records their CRLF bytes.
apps/stream-curves/data/nrsa/sources.lock.json -text whitespace=cr-at-eol
apps/stream-curves/data/nrsa/station_screen.meta.json -text whitespace=cr-at-eol
# The legacy-1819 NRSA files: data/nrsa_provenance.json records their CRLF bytes, and every
# published run manifest fingerprints nrsa_sites.csv (inputs.nrsa_sites), so they stay byte
# identical in every checkout, CI run and desktop payload.
apps/stream-curves/data/nrsa_sites.csv -text whitespace=cr-at-eol
apps/stream-curves/data/nrsa_metric_catalog.csv -text whitespace=cr-at-eol
# Fingerprinted with CRLF line endings into the published run manifests (configs[]), so a
# rebuild anywhere reaches the recorded inputsDigest.
apps/stream-curves/config/national_stratifier_registry.yaml -text whitespace=cr-at-eol
# EASI method versions in the assessment library: the method files are the exact bytes EASI
# scores with and its method digest hashes (two of them are recorded with CRLF).
apps/library/assessments/*/v*/method/* -text
