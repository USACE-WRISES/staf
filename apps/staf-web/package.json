{
  "name": "staf-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "STAF (EASI, SFARI, DEEP) as a static web app, a section of the STAF website at /staf/app/: a TypeScript clone of the Shiny STAF app that reads STAF's published data by HTTP range. npm run build writes docs/app/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/after-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "geotiff": "^3.0.5",
    "hyparquet": "^1.31.3",
    "hyparquet-compressors": "^1.1.2",
    "leaflet": "1.9.4",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/proj4": "^2.5.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
